"""
판매 트리거 기반 콘텐츠 행 조회
--------------------------------
기준 시트의 U(바이럴)/Y(숏폼)/AC(기획사이다) 판매수량이 임계값(THRESHOLD) 이상인 행에 대해,
해당일(A열) 및 직전일의 해당 매체 콘텐츠 행을 조회한다.

사전 준비
  pip install gspread google-auth
  - 서비스 계정 JSON 생성 후 SERVICE_ACCOUNT_FILE 경로 지정
  - 4개 스프레드시트 모두 서비스 계정 이메일에 '보기' 권한 공유

매체별 라우팅
  - 바이럴 : 브랜드로 시트 결정(포벰브/뉴트리딥). 1행 날짜열에서 해당일·직전일 열을 찾아
            그 열의 값이 1~3인 행을 콘텐츠 행으로 반환.
  - 숏폼   : 란시노/라쉼 숏폼 시트 2개에서 (발행일, 브랜드, 제품) 일치 행 반환.
  - 기획사이다 : 기획사이다 시트에서 (게시일자, 브랜드, 제품) 일치 행 반환.
"""

import re
import datetime as dt
from typing import Optional, Set, List

import gspread
from google.oauth2.service_account import Credentials

# ============================== CONFIG ==============================
SERVICE_ACCOUNT_FILE = "service_account.json"
THRESHOLD = 1                       # 판매수량 임계값(이 값 이상이면 조회). 수정 가능.
VIRAL_VALID_VALUES = {1, 2, 3}      # 바이럴 시트 날짜열에서 콘텐츠로 인정하는 값

# 기준 시트 ----------------------------------------------------------
BASE_SS = "1kD_A6SUqYaNBHlfqUz_Ejxcb_LOUtqfy9eLO9wzsCsk"
BASE_GID = 1924633444
BASE_HEADER_ROWS = 2                # 데이터 시작 전 헤더 행 수(1·2행 헤더, 데이터는 3행부터)
# 기준 시트 컬럼(1-based): A=날짜, B=브랜드, C=제품, U=바이럴, Y=숏폼, AC=기획사이다
BASE_COLS = {"date": 1, "brand": 2, "product": 3,
             "viral": 21, "short": 25, "plan": 29}

# 바이럴 콘텐츠 시트 -------------------------------------------------
VIRAL_SS = "1Hss4F1RTVHpRUOZ5Fj5u8dQPQAKc5-36eN0qgbV6w7U"
VIRAL_SHEETS = {
    # date_start_col: 1행에서 날짜가 시작되는 열(1-based)
    "포벰브":   {"gid": 1295662690, "date_start_col": 11},  # K열
    "뉴트리딥": {"gid": 342047231,  "date_start_col": 12},  # L열
}

# 숏폼 콘텐츠 시트(2개) ----------------------------------------------
SHORTFORM_SS = "1IoG5LJlnF_RvFJ75S3YhTzgnNSAq997Y14mRPGc_Ub0"
SHORTFORM_GIDS = [0, 1997235478]
SHORTFORM_COLS = {"date": 3, "brand": 4, "product": 5}      # C, D, E
SHORTFORM_HEADER_ROWS = 1

# 기획사이다 콘텐츠 시트 ---------------------------------------------
PLAN_SS = SHORTFORM_SS
PLAN_GID = 1684626373
PLAN_COLS = {"brand": 5, "product": 6, "date": 7}           # E, F, G
PLAN_HEADER_ROWS = 1
# ===================================================================


# ------------------------------ 유틸 -------------------------------
def parse_date(v, context_year: Optional[int] = None) -> Optional[dt.date]:
    """다양한 형식의 날짜 값을 date로 변환. 연도 없는 값은 context_year 사용."""
    if v is None:
        return None
    if isinstance(v, dt.datetime):
        return v.date()
    if isinstance(v, dt.date):
        return v
    if isinstance(v, (int, float)):
        try:
            return dt.date(1899, 12, 30) + dt.timedelta(days=int(v))
        except Exception:
            return None
    s = str(v).strip()
    if not s:
        return None
    # 시리얼 숫자 문자열
    if re.fullmatch(r"\d+(\.\d+)?", s):
        try:
            return dt.date(1899, 12, 30) + dt.timedelta(days=int(float(s)))
        except Exception:
            pass
    # 한글: 2026년 5월 29일 / 5월 29일
    m = re.fullmatch(r"(?:(\d{4})년\s*)?(\d{1,2})월\s*(\d{1,2})일", s)
    if m:
        y = int(m.group(1)) if m.group(1) else context_year
        if y:
            return dt.date(y, int(m.group(2)), int(m.group(3)))
    # 구분자: 2026-05-29 / 2026.5.29 / 5/29 / 05.29.
    m = re.fullmatch(r"(?:(\d{4})[.\-/]\s*)?(\d{1,2})[.\-/]\s*(\d{1,2})\.?", s)
    if m:
        y = int(m.group(1)) if m.group(1) else context_year
        if y:
            return dt.date(y, int(m.group(2)), int(m.group(3)))
    return None


def to_int(v) -> Optional[int]:
    try:
        f = float(str(v).strip())
        return int(f) if f == int(f) else None
    except Exception:
        return None


def to_num(v) -> float:
    try:
        return float(str(v).strip())
    except Exception:
        return 0.0


def cell(row: List[str], col_1based: int) -> str:
    """행 리스트에서 1-based 컬럼 값을 안전하게 반환."""
    idx = col_1based - 1
    return row[idx] if 0 <= idx < len(row) else ""


def get_values(client, ss_id: str, gid: int, cache: dict) -> List[List[str]]:
    key = (ss_id, gid)
    if key not in cache:
        ws = client.open_by_key(ss_id).get_worksheet_by_id(gid)
        cache[key] = ws.get_all_values()
    return cache[key]


# --------------------------- 매체별 조회 ---------------------------
def fetch_viral(client, brand: str, dates: Set[dt.date], cache: dict) -> List[List[str]]:
    cfg = VIRAL_SHEETS.get(brand.strip())
    if not cfg:                                   # 바이럴 대상 브랜드가 아니면 건너뜀
        return []
    values = get_values(client, VIRAL_SS, cfg["gid"], cache)
    if not values:
        return []
    header = values[0]
    start = cfg["date_start_col"] - 1             # 0-based
    ctx_year = next(iter(dates)).year if dates else None

    target_cols = [c for c in range(start, len(header))
                   if parse_date(header[c], ctx_year) in dates]

    out, seen = [], set()
    for c in target_cols:
        for r in range(1, len(values)):
            row = values[r]
            val = row[c] if c < len(row) else ""
            if to_int(val) in VIRAL_VALID_VALUES:
                content = row[:start]             # 콘텐츠 메타데이터(날짜열 이전)
                sig = tuple(content)
                if sig not in seen:
                    seen.add(sig)
                    out.append(content)
    return out


def fetch_shortform(client, brand: str, product: str,
                    dates: Set[dt.date], cache: dict) -> List[List[str]]:
    out = []
    for gid in SHORTFORM_GIDS:
        values = get_values(client, SHORTFORM_SS, gid, cache)
        for row in values[SHORTFORM_HEADER_ROWS:]:
            d = parse_date(cell(row, SHORTFORM_COLS["date"]))
            if d in dates \
               and cell(row, SHORTFORM_COLS["brand"]).strip() == brand.strip() \
               and cell(row, SHORTFORM_COLS["product"]).strip() == product.strip():
                out.append(row)
    return out


def fetch_plan(client, brand: str, product: str,
               dates: Set[dt.date], cache: dict) -> List[List[str]]:
    out = []
    values = get_values(client, PLAN_SS, PLAN_GID, cache)
    for row in values[PLAN_HEADER_ROWS:]:
        d = parse_date(cell(row, PLAN_COLS["date"]))
        if d in dates \
           and cell(row, PLAN_COLS["brand"]).strip() == brand.strip() \
           and cell(row, PLAN_COLS["product"]).strip() == product.strip():
            out.append(row)
    return out


# ------------------------------ 메인 -------------------------------
def run() -> List[dict]:
    scopes = ["https://www.googleapis.com/auth/spreadsheets.readonly"]
    creds = Credentials.from_service_account_file(SERVICE_ACCOUNT_FILE, scopes=scopes)
    client = gspread.authorize(creds)
    cache: dict = {}

    base = get_values(client, BASE_SS, BASE_GID, cache)
    results: List[dict] = []

    for row in base[BASE_HEADER_ROWS:]:
        date = parse_date(cell(row, BASE_COLS["date"]))
        brand = cell(row, BASE_COLS["brand"]).strip()
        product = cell(row, BASE_COLS["product"]).strip()
        if date is None:
            continue

        dates = {date, date - dt.timedelta(days=1)}   # 해당일 + 직전일

        checks = [
            ("바이럴",     to_num(cell(row, BASE_COLS["viral"])),
             lambda: fetch_viral(client, brand, dates, cache)),
            ("숏폼",       to_num(cell(row, BASE_COLS["short"])),
             lambda: fetch_shortform(client, brand, product, dates, cache)),
            ("기획사이다", to_num(cell(row, BASE_COLS["plan"])),
             lambda: fetch_plan(client, brand, product, dates, cache)),
        ]

        for medium, qty, fetcher in checks:
            if qty >= THRESHOLD:
                contents = fetcher()
                results.append({
                    "date": date, "brand": brand, "product": product,
                    "medium": medium, "qty": qty, "contents": contents,
                })
    return results


def main():
    results = run()
    for r in results:
        print(f"\n[트리거] {r['date']} | {r['brand']} | {r['product']} "
              f"| {r['medium']} | 수량={r['qty']:g} | 콘텐츠 {len(r['contents'])}건")
        for c in r["contents"]:
            print("   - " + " | ".join(str(x) for x in c))
    if not results:
        print("조건을 만족하는 행이 없습니다.")


if __name__ == "__main__":
    main()
